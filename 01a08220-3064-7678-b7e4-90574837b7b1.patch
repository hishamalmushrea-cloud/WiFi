+# سير عمل CI المحدّث — انسخ هذا المحتوى كاملاً إلى
+# .github/workflows/build-ipa.yml عبر محرر GitHub على فرع
+# arena/01a08220-wifi (زر Commit مباشرة إلى الفرع).
+#
+# الجديد عن النسخة الحالية:
+#  1. خطوة "فحص الكود قبل البناء": flutter analyze --no-fatal-infos
+#     ثم flutter test — الفشل يوقف البناء.
+#  2. تقرير الفشل في Issue يشمل سجل الفحص أيضاً.
+name: Build iOS IPA
+
+on:
+  push:
+    branches: [arena/*-wifi]
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  issues: write
+
+jobs:
+  build:
+    name: بناء IPA
+    # macos-14 يضمن توفر Xcode 15.4 — آخر إصدار يدعمه Flutter 3.24.5 رسمياً.
+    runs-on: macos-14
+    steps:
+      - name: سحب الكود
+        uses: actions/checkout@v4
+
+      - name: تثبيت Xcode 15.4
+        run: |
+          sudo xcode-select -s /Applications/Xcode_15.4.app
+          xcodebuild -version
+
+      - name: تثبيت Flutter
+        uses: subosito/flutter-action@v2
+        with:
+          channel: stable
+          flutter-version: '3.24.5'
+
+      - name: إصدارات الأدوات
+        run: |
+          flutter --version
+          pod --version
+
+      - name: فحص الكود قبل البناء (analyze + test)
+        id: check
+        continue-on-error: true
+        run: |
+          set -o pipefail
+          {
+            echo "===== flutter analyze ====="
+            flutter analyze --no-fatal-infos
+            echo "===== flutter test ====="
+            flutter test
+          } 2>&1 | tee check.log
+
+      - name: تنزيل الحزم (pub get)
+        id: pub
+        if: steps.check.outcome == 'success'
+        continue-on-error: true
+        run: |
+          set -o pipefail
+          flutter pub get 2>&1 | tee pub_get.log
+
+      - name: توليد الكود وبناء IPA
+        id: build
+        if: steps.pub.outcome == 'success'
+        continue-on-error: true
+        run: |
+          set -o pipefail
+          {
+            echo "===== build_runner ====="
+            dart run build_runner build --delete-conflicting-outputs
+            echo "===== flutter build ipa ====="
+            flutter build ipa --release --no-codesign
+          } 2>&1 | tee build.log
+
+      - name: نشر سبب الفشل في Issue
+        if: steps.check.outcome == 'failure' || steps.pub.outcome == 'failure' || steps.build.outcome == 'failure'
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          {
+            echo "## فشل بناء IPA (iOS)"
+            echo ""
+            echo "الالتزام: ${GITHUB_SHA::7}"
+            echo ""
+            if [ -f check.log ]; then
+              echo "### فحص الكود (analyze/test)"
+              echo '```'
+              tail -n 120 check.log
+              echo '```'
+            fi
+            if [ -f pub_get.log ]; then
+              echo "### pub get"
+              echo '```'
+              tail -n 70 pub_get.log
+              echo '```'
+            fi
+            if [ -f build.log ]; then
+              echo "### build_runner / flutter build ipa"
+              echo '```'
+              tail -n 200 build.log
+              echo '```'
+            fi
+          } > issue_body.md
+          gh issue create --title "❗ خطأ بناء IPA (${GITHUB_SHA::7})" --body-file issue_body.md || true
+          exit 1
+
+      - name: تجميع الملف
+        if: steps.build.outcome == 'success'
+        run: |
+          if [ -f build/ios/ipa/Runner.ipa ]; then
+            echo "✓ flutter أنتج IPA مباشرة"
+            cp build/ios/ipa/Runner.ipa netcontrol-latest.ipa
+          elif [ -d build/ios/archive/Runner.xcarchive/Products/Applications/Runner.app ]; then
+            echo "→ flutter لم ينتج IPA (بسبب --no-codesign) — تجميعه يدوياً من الأرشيف"
+            rm -rf Payload netcontrol-latest.ipa
+            mkdir Payload
+            cp -R build/ios/archive/Runner.xcarchive/Products/Applications/Runner.app Payload/Runner.app
+            zip -qry netcontrol-latest.ipa Payload
+            rm -rf Payload
+          else
+            echo "❌ لم يُعثر على IPA ولا أرشيف Xcode" && exit 1
+          fi
+          ls -lh netcontrol-latest.ipa
+
+      - name: رفع IPA كأرتيفكت
+        if: steps.build.outcome == 'success'
+        uses: actions/upload-artifact@v4
+        with:
+          name: netcontrol-ipa
+          path: netcontrol-latest.ipa
+          retention-days: 30
+
+      - name: نشر Release مع IPA
+        if: steps.build.outcome == 'success'
+        uses: softprops/action-gh-release@v2
+        with:
+          tag_name: ipa-latest
+          name: نت كونترول — NetControl IPA
+          body: |
+            ملف IPA غير موقّع (development) — يدعم iOS 14.0+.
+
+            **التثبيت:**
+            - عبر **Sideloadly** أو **AltStore** على أي جهاز كمبيوتر
+              (يُعاد التوقيع تلقائياً بأي Apple ID، وبدون حساب مطوّر).
+            - أو مباشرة على جهاز iOS jailbreak.
+          files: netcontrol-latest.ipa
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
